  m_Script: {fileID: 11500000, guid: 0b520a150205db241b653de766eb7095, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BeastWar.UI.WorldIntroUI
  introPanel: {fileID: 1737308098}
  introText: {fileID: 580220664}
  nextButton: {fileID: 304888852}
  backButton: {fileID: 583237308}
  nextArrowIndicator: {fileID: 723760707}
  introPages:
  - "Trong th\u1EBF gi\u1EDBi n\xE0y, b\u1EA1n s\u1EBD b\u1EAFt tay v\xE0o 1 cu\u1ED9c
    \u0111\u1EA1i phi\xEAu l\u01B0u m\xE0 b\u1EA1n s\u1EBD nh\u01B0 1 v\u1ECB anh
    h\xF9ng.\n\nTr\xF2 chuy\u1EC7n v\u1EDBi m\u1ECDi ng\u01B0\u1EDDi, ki\u1EC3m tra
    m\u1ECDi th\u1EE9 \u1EDF b\u1EA5t c\u1EE9 n\u01A1i n\xE0o b\u1EA1n \u0111i, th\u1ECB
    tr\u1EA5n, tr\xEAn \u0111\u01B0\u1EDDng hay hang \u0111\u1ED9ng. Thu th\u1EADp
    th\xF4ng tin, g\u1EE3i \xFD t\u1EEB m\u1ECDi ngu\u1ED3n."
  - "Nh\u1EEFng con \u0111\u01B0\u1EDDng m\u1EDBi s\u1EBD m\u1EDF ra khi b\u1EA1n
    gi\xFAp ng\u01B0\u1EDDi kh\xE1c, v\u01B0\u1EE3t qua th\u1EED th\xE1ch, gi\u1EA3i
    quy\u1EBFt b\xED \u1EA9n.\n\n\u0110\xF4i khi b\u1EA1n s\u1EBD b\u1ECB th\xE1ch
    th\u1EE9c b\u1EDFi nh\u1EEFng HLV kh\xE1c & b\u1ECB PKM hoang d\xE3 t\u1EA5n
    c\xF4ng. H\xE3y d\u0169ng c\u1EA3m & ti\u1EBFn l\xEAn ph\xEDa tr\u01B0\u1EDBc."
  - "Th\xF4ng qua \u0111\xF3, ch\xFAng t\xF4i hy v\u1ECDng r\u1EB1ng b\u1EA1n s\u1EBD
    t\u01B0\u01A1ng t\xE1c v\u1EDBi m\u1ECDi lo\u1EA1i ng\u01B0\u1EDDi v\xE0 \u0111\u1EA1t
    \u0111\u01B0\u1EE3c ph\xE1t tri\u1EC3n c\xE1 nh\xE2n. \u0110\xF3 l\xE0 m\u1EE5c
    ti\xEAu l\u1EDBn nh\u1EA5t c\u1EE7a ch\xFAng t\xF4i.\n\nNh\u1EA5n n\xFAt A \u0111\u1EC3
    cu\u1ED9c phi\xEAu l\u01B0u c\u1EE7a b\u1EA1n b\u1EAFt \u0111\u1EA7u!"
  typingSpeed: 0.03
  autoStartOnEnable: 0
  nextKey: 97
  nextKeySecondary: 32
  backKey: 100
  onIntroCompleted:
    m_PersistentCalls:
      m_Calls: []
