  tutorialBeast: {fileID: 11400000, guid: a241c4bf629d39c4ab136cb2068da7ca, type: 2}
  tutorialBeastLevel: 2
  blockingCollider: {fileID: 55895266}
  questIdToUnlockAfter: 0
  dialoguePhase1:
  - "N\xE0y... ta \u0111\u1EE9ng \u0111\xE2y m\xE0 m\u1EAFt m\u1EDD, ch\xE2n y\u1EBFu
    qu\xE1. Ch\xE1u c\xF3 th\u1EC3 mua cho ta m\u1ED9t t\xE1ch C\xE0 Ph\xEA t\u1EEB
    C\u1EEDa H\xE0ng trong l\xE0ng kh\xF4ng?"
  - "Mang C\xE0 Ph\xEA l\u1EA1i cho ta, ta s\u1EBD ch\u1EC9 ch\xE1u c\xE1ch b\u1EAFt
    nh\u1EEFng ch\xFA Th\xFA hoang d\xE3 \u0111\u1EA5y nh\xE9!"
  dialoguePhase2:
  - "\u1ED2... ch\xE1u ch\u01B0a mang C\xE0 Ph\xEA l\u1EA1i cho ta \xE0? C\u1EEDa
    H\xE0ng ngay trong l\xE0ng \u0111\xF3, \u0111\u1EEBng qu\xEAn nh\xE9!"
  dialoguePhase3:
  - "\u1ED2! Ch\xE1u t\u1ED1t b\u1EE5ng qu\xE1! \u0110\xE2y \u0111\xFAng l\xE0 th\u1EE9
    ta c\u1EA7n r\u1ED3i. U\u1ED1ng xong t\u1EC9nh h\u1EB3n ng\u01B0\u1EDDi!"
  - "Ta s\u1EBD d\u1EA1y ch\xE1u b\xED quy\u1EBFt b\u1EAFt Th\xFA:\n\u2605 M\xE1u
    qu\xE1i c\xE0ng th\u1EA5p \u2192 T\u1EC9 l\u1EC7 b\u1EAFt c\xE0ng cao!\n\u2605
    D\xF9ng K\u1EF9 N\u0103ng l\xE0m y\u1EBFu qu\xE1i tr\u01B0\u1EDBc khi n\xE9m
    B\xF3ng.\n\u2605 C\u1EE9 th\u1EED v\xE0i l\u1EA7n \u2014 B\xF3ng c\xF3 th\u1EC3
    th\u1EA5t b\u1EA1i, \u0111\u1EEBng n\u1EA3n!"
  - "B\xE2y gi\u1EDD ta t\u1EB7ng ch\xE1u {0} B\xF3ng Thu Ph\u1EE5c \u0111\u1EC3
    b\u1EAFt \u0111\u1EA7u h\xE0nh tr\xECnh nh\xE9!\nCh\xFAc ch\xE1u may m\u1EAFn!
    \u0110\u01B0\u1EDDng ph\xEDa tr\u01B0\u1EDBc \u0111\xE3 r\u1ED9ng m\u1EDF r\u1ED3i
    \u0111\xF3!"
